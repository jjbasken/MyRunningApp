    <!-- Training plan -->
    <string name="nav_plan">Plan</string>
    <string name="action_close">Close</string>
    <string name="plan_title">Training plan</string>
    <string name="plan_empty_intro">Import a training plan written by an AI assistant, and the app will coach you through it: today\'s workout on the Track screen, spoken pace and distance cues while you run, and each run ticked off the plan when you finish.</string>
    <string name="plan_step_label">Step %1$d</string>
    <string name="plan_step_prompt">Tell the app about your race and your running now. It writes a prompt for you to give to an AI assistant such as Claude.</string>
    <string name="plan_step_ask">Paste the prompt into the assistant. When it replies with the plan, copy the whole reply.</string>
    <string name="plan_step_import">Come back here and paste it in, or open it if you saved it as a file.</string>
    <string name="plan_privacy_note">The app never contacts an AI service itself: you choose what to share in the chat, and your runs stay on this phone.</string>
    <string name="plan_get_prompt">Write AI prompt</string>
    <string name="plan_paste">Paste plan</string>
    <string name="plan_open_file">Open file</string>
