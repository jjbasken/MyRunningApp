    <!-- Permissions -->
    <string name="permission_location_title">Location access</string>
    <string name="permission_location_message">MyRunningApp needs your location to measure how far you go and draw your route. Nothing leaves your phone.</string>
    <string name="permission_background_title">Keep tracking with the screen off</string>
    <string name="permission_background_message">To keep recording once your screen turns off — a phone in a pocket, for most of a run — Android needs background location access, set to “Allow all the time”.\n\nYou can skip this. Tracking still works while the app is open.</string>
    <string name="permission_background_settings">Android asks for this in Settings: choose Permissions, then Location, then “Allow all the time”.</string>
